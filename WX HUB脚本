-- ============================================================
--   WX HUB · 外部执行链接加载器 v10（2026-10-03 永不静默版）
-- ------------------------------------------------------------
--  v10 相对 v9 的教训总结：
--   1. 【哨兵自检】源码级检测前先看本脚本是否明文，被混淆则自动降级
--      为"按全局值判定"，杜绝 v9 在某些执行器/混淆产物上直接死机的风险
--   2. 【永不静默】全程 print 留痕 + 外层 xpcall 兜底：任何内部错误
--      都会在控制台打印堆栈，并在屏幕上弹红字报错画面
--   3. 【kick 加固】有界等待 LocalPlayer（修复 v9 可能死等 PlayerAdded
--      的隐患），连踢 3 次，踢不动就原地封锁
--   判定优先级：
--     确凿没写 SCRIPT_KEY 行（源码检测可用时）→ 踢
--     全局无值 → 踢
--     有效卡密 → 直接执行主脚本
--     其余（空串/空白/太短/非字符串）→ 弹紫色买卡 UI
-- ============================================================

print("[WXHUB v10] 加载器入口已触发（看到本行 = 文件已更新成功）")

local function WXHUB_fatalError(msg)
    print("[WXHUB v10] 内部错误 ->", msg)
    pcall(function()
        local pg = nil
        if typeof(gethui) == "function" then
            local ok, r = pcall(gethui)
            if ok then pg = r end
        end
        if not pg then
            local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
            if ok2 then pg = cg end
        end
        if not pg then
            local lp = game:GetService("Players").LocalPlayer
            if lp then pg = lp:FindFirstChildOfClass("PlayerGui") end
        end
        if not pg then return end
        local sg = Instance.new("ScreenGui")
        sg.Name = "WXHUB_FatalError"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 999999
        sg.Parent = pg
        local f = Instance.new("Frame")
        f.Size = UDim2.fromScale(1, 1)
        f.BackgroundColor3 = Color3.new(0, 0, 0)
        f.BackgroundTransparency = 0.1
        f.Parent = sg
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.fromScale(1, 1)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.fromRGB(255, 90, 90)
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 18
        tl.TextWrapped = true
        tl.Text = "WX HUB 加载器发生内部错误\n\n" .. tostring(msg):sub(1, 600) .. "\n\n请截图此画面联系作者"
        tl.Parent = f
    end)
end

local function WXHUB_MAIN()
    local MAIN_URL = "https://api.jnkie.com/api/v1/luascripts/public/17c623de8d29bf1f8de353253ab468722d61b3ffce34150ca6302f08d96d65d2/download"
    local BUY_URL  = "https://ds.xiaoman.top/links/342F4A3D"

    local Players      = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local LocalPlayer  = Players.LocalPlayer

    -- ============================================================
    --  【修复】loadMain 全包裹：失败必须让用户看见原因
    -- ============================================================
    local function loadMain()
        loadstring(game:HttpGet(MAIN_URL))()
    end

    -- ═══════════ 三重门禁判定（v10：哨兵自检 + 分级检测 + 全程留痕） ═══════════
    -- 设计原则：检测可以降级，功能绝不陪葬。
    --   源码可读（明文上传）+ debug 可用 → 源码级检测：
    --     查"本次调用方"源码里有没有写 SCRIPT_KEY 行，
    --     没写就踢，全局残留旧值一律无视（根治 v8 的串味 bug）。
    --   源码不可读（被混淆成密文）或无 debug → 自动降级为按全局值判定，
    --     保证加载器在任何环境下都能干活。
    -- 全程 print 留痕；外层 xpcall 兜底：任何内部错误直接红字上屏，绝不静默。

    local CANARY = "WXHUB_V10_CANARY_9F3A" -- 明文哨兵：混淆后消失 = 源码检测不可信

    local function kickPlayer(reason)
        local lp = LocalPlayer or Players.LocalPlayer
        if not lp then
            local t0 = tick() -- 有界等待，绝不死等 PlayerAdded
            while not lp and tick() - t0 < 3 do
                task.wait(0.1)
                lp = Players.LocalPlayer
            end
        end
        for i = 1, 3 do
            if lp then pcall(function() lp:Kick(reason) end) end
            task.wait(0.2)
        end
        -- Kick 可能被拦截：原地封锁，姿势C绝不允许脚本继续跑
        while true do task.wait(10) end
    end

    -- 本脚本源码是否还是明文（哨兵还在不在）
    local function selfIsPlain()
        if typeof(debug) ~= "table" or typeof(debug.getinfo) ~= "function" then return false end
        local ok, info = pcall(debug.getinfo, 1, "S")
        if not ok or type(info) ~= "table" or type(info.source) ~= "string" then return false end
        return info.source:find(CANARY, 1, true) ~= nil
    end

    -- 源码级检测：true=调用方写了 / false=没写 / nil=无法确定（降级）
    local function detectCallerKeyLine()
        if typeof(debug) ~= "table" or typeof(debug.getinfo) ~= "function" then return nil end
        local okWalk, result = pcall(function()
            local mySrc = nil
            for level = 1, 8 do
                local ok, info = pcall(debug.getinfo, level, "S")
                if not ok or type(info) ~= "table" or type(info.source) ~= "string" then
                    return nil
                end
                if mySrc == nil then
                    mySrc = info.source
                elseif info.source ~= mySrc then
                    return info.source:lower():find("script_key", 1, true) ~= nil
                end
            end
            return nil
        end)
        if not okWalk then return nil end
        return result
    end

    local plain = selfIsPlain()
    local keyLine = plain and detectCallerKeyLine() or nil
    local rawKey = getgenv().SCRIPT_KEY
    local keyLen = (type(rawKey) == "string") and #rawKey:gsub("%s", "") or 0

    print("[WXHUB] 检测明细 -> 源码可读:", plain,
        "| 调用方写了KEY行:", tostring(keyLine),
        "| 卡密长度:", keyLen)

    -- 姿势C：确凿没写行，或全局根本没值 → 踢
    if keyLine == false or rawKey == nil then
        print("[WXHUB] 判定：姿势C -> 踢出服务器")
        kickPlayer("你没有使用正确的执行链接")
        return -- 到不了这里，kickPlayer 内已封锁
    end

    -- 姿势A：有效卡密（源码检测可用时必须确认写了行；不可用时按值放行）→ 直接执行
    if keyLen > 3 then
        print("[WXHUB] 判定：姿势A -> 加载主脚本")
        getgenv().SCRIPT_KEY = rawKey:gsub("%s", "")
        loadMain()
        return
    end

    -- 姿势B：写了行但没给有效卡密（空串/纯空白/太短/非字符串）→ 弹买卡 UI
    print("[WXHUB] 判定：姿势B -> 显示卡密UI")

    -- ═══════════ 姿势B：全屏紫色UI ═══════════

    local parentGui
