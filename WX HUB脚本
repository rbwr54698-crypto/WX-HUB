--═══════════════════ 交互逻辑 ═══════════════════

local busy = false

local function runWithKey()
    if busy then return end
    local key = input.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if key == "" then
        statusLabel.Text = "⚠ 请先输入卡密再执行！"
        task.spawn(function()
            for _ = 1, 2 do
                TweenService:Create(input, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(80, 15, 35)}):Play()
                task.wait(0.13)
                TweenService:Create(input, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(10, 5, 18)}):Play()
                task.wait(0.13)
            end
        end)
        return
    end
    busy = true
    execBtn.Text = "正在执行..."
    task.wait(0.25)
    screenGui:Destroy()
    executeTarget(key)
end

execBtn.MouseButton1Click:Connect(runWithKey)
input.FocusLost:Connect(function(enterPressed)
    if enterPressed then runWithKey() end
end)

