end

-- ═══════════ 三重门禁判定（v9 加固：调用方源码级检测） ═══════════
-- 【病根】getgenv() 是整个注入会话共享的全局变量，旧版只读它的值，
-- 导致"残留卡密污染判定"：
--   现象1：先跑姿势B（SCRIPT_KEY 被写成 ""）→ 同会话再跑姿势C（链接里
--         根本没写 SCRIPT_KEY 行）→ 读到上次的残留空串 → 不踢，反而弹 UI。
--   现象2：先跑姿势A（写了真卡密）→ 同会话再跑姿势C → 读到残留卡密
--         → 不踢，直接执行主脚本。
-- 【治法】不再只信全局的值，而是直接检查"本次调用方"的源码里有没有写
-- SCRIPT_KEY 这一行——没写就无条件踢出，全局里残留什么都不管。
-- 注意： SCRIPT_KEY 那行必须写在 loadstring 调用之前（本来就该这么写）。

local function kickPlayer(reason)
    local lp = LocalPlayer
    if not lp then
        pcall(function() lp = Players.PlayerAdded:Wait() end)
    end
    if lp then
        pcall(function() lp:Kick(reason) end)
    end
end

-- 遍历调用栈，跳过本脚本自己的 chunk，找到第一个外部调用方，
-- 检查其源码中是否出现 script_key（大小写不敏感）。
-- 拿不到源码时返回 true，回退为"信任旧判定"，保证绝不误踢。
local function callerHasKeyLine()
    local mySrc = nil
    for level = 1, 8 do
        local ok, info = pcall(debug.getinfo, level, "S")
        if not ok or type(info) ~= "table" or type(info.source) ~= "string" then
            return true
        end
        if mySrc == nil then
            mySrc = info.source
        elseif info.source ~= mySrc then
            return info.source:lower():find("script_key", 1, true) ~= nil
        end
    end
    return true
end

local keyLinePresent = callerHasKeyLine()
local rawKey = getgenv().SCRIPT_KEY

-- 姿势C：调用方链接里没写 SCRIPT_KEY 行（或写了 nil）→ 无条件踢出
if (not keyLinePresent) or rawKey == nil then
    kickPlayer("你没有使用正确的执行链接")
    return
end

-- 姿势A：字符串卡密且去空格后长度 > 3 → 写回全局 → 直接执行主脚本
if type(rawKey) == "string" then
    local key = rawKey:gsub("%s", "")
    if #key > 3 then
        getgenv().SCRIPT_KEY = key
        loadMain()
        return
    end
end

