    round(closeBtn, 19)
    closeBtn.Parent = card

    closeBtn.MouseEnter:Connect(function()
        closeBtn.BackgroundColor3 = Color3.fromRGB(88, 28, 135)
        closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    closeBtn.MouseLeave:Connect(function()
        closeBtn.BackgroundColor3 = Color3.fromRGB(34, 26, 52)
        closeBtn.TextColor3 = Color3.fromRGB(196, 181, 253)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        tween(card, 0.3, { BackgroundTransparency = 1, Position = UDim2.new(0.5, -CARD_W / 2, 0.5, -CARD_H / 2 + 24) })
        tween(cardGlow, 0.3, { BackgroundTransparency = 1 })
        tween(bg, 0.4, { BackgroundTransparency = 1 })
        task.delay(0.42, function() gui:Destroy() end)
    end)

    -- ═══════════ 执行逻辑（所有元素声明完毕之后才定义，闭包零风险） ═══════════
    local isExecuting = false

    local function shakeInput()
        local basePos = inputWrap.Position
        tween(inputWrap, 0.06, { Position = basePos + UDim2.fromOffset(-8, 0) })
        task.wait(0.06)
        tween(inputWrap, 0.06, { Position = basePos + UDim2.fromOffset(8, 0) })
        task.wait(0.06)
        tween(inputWrap, 0.06, { Position = basePos })
    end

    local function doExecute()
        if isExecuting then return end   -- 防连点

        local key = input.Text:gsub("%s", "")

        -- 【修复】与链接路径统一：长度 > 3 即放行，由服务器校验卡密真伪
        if #key == 0 then
            tip.Text = "⚠ 卡密为空，请先粘贴卡密！"
            shakeInput()
            return
        elseif #key <= 3 then
            tip.Text = "⚠ 卡密太短，请检查是否复制完整！"
            shakeInput()
            return
        end

        isExecuting = true
        tip.Text = ""
        getgenv().SCRIPT_KEY = key
        tween(card, 0.3, { BackgroundTransparency = 1 })
        tween(cardGlow, 0.3, { BackgroundTransparency = 1 })
        tween(bg, 0.3, { BackgroundTransparency = 1 })
        task.delay(0.32, function()
            gui:Destroy()
            loadMain()
        end)
    end

    runBtn.MouseButton1Click:Connect(doExecute)
    input.FocusLost:Connect(function(enter)
        if enter then doExecute() end
    end)


end

local WXHUB_ok, WXHUB_err = xpcall(WXHUB_MAIN, function(m)
    if typeof(debug) == "table" and typeof(debug.traceback) == "function" then
        return debug.traceback(m, 2)
    end
    return m
end)

if not WXHUB_ok then
    WXHUB_fatalError(WXHUB_err)
end
