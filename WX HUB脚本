RunService.RenderStepped:Connect(function(dt)
    if not particleLayer.Parent then return end
    if math.random() < 0.35 and #particles < 70 then
        table.insert(particles, newParticle(true))
    end
    for i = #particles, 1, -1 do
        local it = particles[i]
        local o = it.obj
        if not o or not o.Parent then
            table.remove(particles, i)
        else
            local pos = o.Position
            local ny = pos.Y.Scale - it.vy * dt
            local nx = pos.X.Scale + it.vx * dt
            if ny < -0.05 then
                o:Destroy()
                table.remove(particles, i)
            else
                o.Position = UDim2.new(nx, 0, ny, 0)
                it.tw = it.tw + dt * 2
                o.BackgroundTransparency = 0.45 + math.sin(it.tw) * 0.25
            end
        end
    end
end)

