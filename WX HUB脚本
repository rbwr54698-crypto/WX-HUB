    subtitle.TextColor3 = Color3.fromRGB(148, 140, 175)
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextSize = 13
    subtitle.Parent = card

    -- 输入框外框 y=96  h=48（左右边距36）
    local inputWrap = Instance.new("Frame")
    inputWrap.Size = UDim2.fromOffset(CARD_W - 72, 48)
    inputWrap.Position = UDim2.fromOffset(36, 96)
    inputWrap.BackgroundColor3 = Color3.fromRGB(22, 17, 36)
    inputWrap.BorderSizePixel = 0
    round(inputWrap, 14)
    inputWrap.Parent = card

    local inputStroke = Instance.new("UIStroke")
    inputStroke.Color = Color3.fromRGB(109, 74, 199)
    inputStroke.Thickness = 1.5
    inputStroke.Transparency = 0.25
    inputStroke.Parent = inputWrap

    local input = Instance.new("TextBox")
    input.Size = UDim2.fromOffset(CARD_W - 72 - 28, 48)
    input.Position = UDim2.fromOffset(14, 0)
    input.BackgroundTransparency = 1
    input.Text = ""
    input.PlaceholderText = "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
    input.PlaceholderColor3 = Color3.fromRGB(96, 88, 128)
