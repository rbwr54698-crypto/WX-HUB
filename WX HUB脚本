local function hoverFx(btn)
    local origin = btn.Size
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {Size = origin + UDim2.fromOffset(8, 3)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {Size = origin}):Play()
    end)
end
