    task.spawn(function()
        while gui and gui.Parent do
            local p = Instance.new("Frame")
            local size = RNG:NextInteger(7, 18)
            p.Size = UDim2.fromOffset(size, size)
            p.Position = UDim2.new(RNG:NextNumber(), 0, 1 + RNG:NextNumber() * 0.2, 0)
            p.BackgroundColor3 = PARTICLE_COLORS[RNG:NextInteger(1, #PARTICLE_COLORS)]
            p.BackgroundTransparency = RNG:NextNumber(0.1, 0.45)
            p.BorderSizePixel = 0
            p.Active = false        -- 绝不拦截鼠标
            round(p, size)
            p.Parent = bg

            local life  = RNG:NextNumber(4, 9)
            local drift = RNG:NextInteger(-140, 140)
            local grow  = RNG:NextNumber(1.1, 1.9)

            local tw = tween(p, life, {
                Position = UDim2.new(p.Position.X.Scale, drift, -0.15, 0),
                Size = UDim2.fromOffset(size * grow, size * grow),
                BackgroundTransparency = 1,
            }, Enum.EasingStyle.Linear)
            tw.Completed:Connect(function() p:Destroy() end)

            task.delay(life * RNG:NextNumber(0.3, 0.6), function()
                if p and p.Parent then
                    tween(p, 0.4, { BackgroundTransparency = 0.85 })
                end
            end)

            task.wait(RNG:NextNumber(0.12, 0.3))
        end
    end)

    -- ═══════════ 中央卡片（460×320，全部绝对坐标，零锚点混用） ═══════════
    local CARD_W, CARD_H = 460, 320

    -- 呼吸光晕底
    local cardGlow = Instance.new("Frame")
    cardGlow.Size = UDim2.fromOffset(CARD_W + 10, CARD_H + 10)
    cardGlow.Position = UDim2.new(0.5, -(CARD_W + 10) / 2, 0.5, -(CARD_H + 10) / 2)
    cardGlow.BackgroundColor3 = Color3.fromRGB(139, 92, 246)
    cardGlow.BackgroundTransparency = 0.6
    cardGlow.BorderSizePixel = 0
    round(cardGlow, 28)
    cardGlow.Parent = bg

    local glowGrad = Instance.new("UIGradient")
    glowGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(168, 85, 247)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(88, 28, 135)),
    })
    glowGrad.Parent = cardGlow

    task.spawn(function()
        while cardGlow and cardGlow.Parent do
            tween(cardGlow, 2.2, { BackgroundTransparency = 0.8 }, Enum.EasingStyle.Sine)
            task.wait(2.2)
            if not (cardGlow and cardGlow.Parent) then break end
            tween(cardGlow, 2.2, { BackgroundTransparency = 0.55 }, Enum.EasingStyle.Sine)
            task.wait(2.2)
        end
    end)

    -- 卡片本体
    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(CARD_W, CARD_H)
    card.Position = UDim2.new(0.5, -CARD_W / 2, 0.5, -CARD_H / 2 + 24)  -- 初始偏下24px，开场上浮
    card.BackgroundColor3 = Color3.fromRGB(14, 11, 24)
    card.BackgroundTransparency = 1                                       -- 开场淡入
    card.BorderSizePixel = 0
    round(card, 24)
    card.ClipsDescendants = true
    card.Parent = bg

    local cardGrad = Instance.new("UIGradient")
    cardGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 18, 46)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(11, 9, 20)),
