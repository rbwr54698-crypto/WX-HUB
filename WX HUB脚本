local particleLayer = Instance.new("Frame")
particleLayer.Name = "Particles"
particleLayer.Size = UDim2.fromScale(1, 1)
particleLayer.BackgroundTransparency = 1
particleLayer.BorderSizePixel = 0
particleLayer.ClipsDescendants = false
particleLayer.ZIndex = 2
particleLayer.Parent = gui

local particles = {}

local function newParticle(fromBottom)
    local size = math.random(3, 8)
    local p = Instance.new("Frame")
    p.Size = UDim2.fromOffset(size, size)
    p.BackgroundColor3 = Color3.fromRGB(170, 110, 255)
    p.BackgroundTransparency = math.random(35, 75) / 100
    p.BorderSizePixel = 0
    p.ZIndex = 2
    p.Position = UDim2.new(
        math.random(),
        0,
        fromBottom and 1.02 or math.random(),
        0
    )
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = p
    p.Parent = particleLayer

    return {
        obj     = p,
        vy      = math.random(30, 100) / 1000,
        vx      = math.random(-25, 25) / 1000,
        twinkle = math.random(0, 100) / 100,
    }
end

-- 初始铺一批
for _ = 1, 45 do
    table.insert(particles, newParticle(false))
end

RunService.RenderStepped:Connect(function(dt)
    if not particleLayer.Parent then return end

    -- 持续补充新粒子
    if math.random() < 0.35 and #particles < 70 then
        table.insert(particles, newParticle(true))
    end

    for i = #particles, 1, -1 do
        local item = particles[i]
        local o = item.obj
        if not o or not o.Parent then
            table.remove(particles, i)
        else
            local pos = o.Position
            local ny = pos.Y.Scale - item.vy * dt
            local nx = pos.X.Scale + item.vx * dt

            if ny < -0.05 then
                o:Destroy()
                table.remove(particles, i)
            else
                o.Position = UDim2.new(nx, 0, ny, 0)
                item.twinkle = item.twinkle + dt * 2
                o.BackgroundTransparency = 0.45 + math.sin(item.twinkle) * 0.25
            end
        end
    end
end)

