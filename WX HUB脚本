-- ============================================================
--   WX HUB · 外部执行链接加载器 v9（2026-10-03 检测加固版）
-- ------------------------------------------------------------
--  三种姿势：
--   A) getgenv().SCRIPT_KEY = "2a20c53b-35f6-4328-8089-6075efe3a688"
--      → 卡密清洗空白后写入全局 → 直接加载主脚本，零弹窗
--   B) getgenv().SCRIPT_KEY = ""
--      → 弹出全屏紫色 UI：纯黑背景铺满全屏 + 紫色上升粒子
--        + 中央卡片卡密输入框（占位符即 X 符号卡密格式）
--   C) 执行链接里没有写 SCRIPT_KEY 这一行
--      → 直接踢出服务器，理由：你没有使用正确的执行链接
--
--  本文件为纯 Luau 平铺结构：无 setfenv 外壳 / 无反 Hook 自踢 /
--  无环境探测，任意 Luau 混淆器（MoonSec V3、Prometheus 等）可直接混淆，
--  混淆后不会与执行器打架。中文 UI 文案请确保混淆器支持 UTF-8。
-- ============================================================

local MAIN_URL = "https://api.jnkie.com/api/v1/luascripts/public/17c623de8d29bf1f8de353253ab468722d61b3ffce34150ca6302f08d96d65d2/download"
