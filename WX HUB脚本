-- 粒子生成：小圆点从底部升起、变淡、消失
local function particleLoop()
    task.spawn(function()
        while screenGui.Parent do
            local size = math.random(3, 7)
            local dot = Instance.new("Frame")
            dot.Size = UDim2.fromOffset(size, size)
            dot.Position = UDim2.new(math.random(2, 98) / 100, 0, 1, 12)
            dot.BackgroundColor3 = Color3.fromHSV(0.72 + math.random() * 0.14, 0.65, 1)
            dot.BackgroundTransparency = 0.25
            dot.BorderSizePixel = 0
            dot.ZIndex = 1
            dot.Parent = particleLayer

            local dc = Instance.new("UICorner")
            dc.CornerRadius = UDim.new(1, 0)
            dc.Parent = dot

            local life = (math.random(28, 55)) / 10
            local tw = TweenService:Create(dot, TweenInfo.new(life, Enum.EasingStyle.Linear), {
                Position = UDim2.new(dot.Position.X.Scale, 0, -0.15, 0),
                BackgroundTransparency = 1,
            })
            tw:Play()
            tw.Completed:Wait()
            dot:Destroy()
            task.wait(math.random(4, 18) / 10)
        end
    end)
end
for _ = 1, 6 do particleLoop() end

