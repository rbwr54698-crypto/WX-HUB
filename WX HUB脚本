--================= 全局捕获（抗混淆）=================--
local function safeGet(name)
    local v = rawget(_G, name)
    if v ~= nil then return v end
    local ok, r = pcall(function() return _G[name] end)
    if ok and r ~= nil then return r end
    return nil
end

local g_getgenv = safeGet("getgenv")
local g_setclip = safeGet("setclipboard")
local g_loadstr = safeGet("loadstring")

local function getEnv()
    if type(g_getgenv) == "function" then
        local ok, env = pcall(g_getgenv)
        if ok and type(env) == "table" then return env end
    end
    return _G
end
local ENV = getEnv()

-- 闭包保留 self，避免 Instance expected, got string
local function g_httpget(url)
    return game:HttpGet(url)
end

