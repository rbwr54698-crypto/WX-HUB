    cardGrad.Rotation = 115
    cardGrad.Parent = card

    local cardStroke = Instance.new("UIStroke")
    cardStroke.Color = Color3.fromRGB(139, 92, 246)
    cardStroke.Thickness = 1.2
    cardStroke.Transparency = 0.35
    cardStroke.Parent = card

    task.spawn(function()
        while cardStroke and cardStroke.Parent do
            tween(cardStroke, 1.8, { Transparency = 0.7 }, Enum.EasingStyle.Sine)
            task.wait(1.8)
            if not (cardStroke and cardStroke.Parent) then break end
            tween(cardStroke, 1.8, { Transparency = 0.25 }, Enum.EasingStyle.Sine)
            task.wait(1.8)
        end
    end)

    -- 开场动画：淡入 + 上浮（不动尺寸，按钮绝不跳动）
    tween(card, 0.5, {
        BackgroundTransparency = 0.04,
        Position = UDim2.new(0.5, -CARD_W / 2, 0.5, -CARD_H / 2),
    })

    -- ═══════════ 卡片内元素（坐标全部手写死） ═══════════

    -- 标题 y=24  h=38
    local title = Instance.new("TextLabel")
