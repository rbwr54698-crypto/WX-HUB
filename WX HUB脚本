-- 圆角 + 渐变 + 描边统一处理
local function dressUp(btn, cA, cB, strokeColor, strokeTrans)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = btn
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, cA),
        ColorSequenceKeypoint.new(1, cB),
    }
    g.Rotation = 30
    g.Parent = btn
    if strokeColor then
        local s = Instance.new("UIStroke")
        s.Thickness = 1.2
        s.Color = strokeColor
        s.Transparency = strokeTrans or 0.4
        s.Parent = btn
    end
end

