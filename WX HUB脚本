local function IntegrityCheck()
    if getgenv().HttpSpy or getgenv().httppyspy then
        return "检测到全局 HttpSpy 变量"
    end

    for _, child in ipairs(CoreGui:GetChildren()) do
        local name = child.Name:lower()
        if name:find("spy") or name:find("http") then
            if child:FindFirstChild("Frame") or child:FindFirstChild("Main") then
                return "检测到非法调试 GUI: " .. child.Name
            end
        end
    end
    
    
    if original_request then
        if iscclosure and not iscclosure(original_request) then
            return "Request 函数被篡改为 Lua Closure"
        end
        
        local info = debug.getinfo(original_request)
        if info.source and (info.source:match("Spy") or info.what == "Lua") then
            return "Request 函数来源异常"
        end
    end
    
    return nil
end

local function StartProtection()
    task.spawn(function()
        while true do
            local reason = IntegrityCheck()
            if reason then
                Punish(reason)
                break
            end
            
            task.wait(math.random(15, 30) / 10) 
        end
    end)

    local conn
    conn = CoreGui.ChildAdded:Connect(function(child)
        local name = child.Name:lower()
        if name:find("spy") or (name:find("http") and name:find("gui")) then
            conn:Disconnect()
            Punish("动态注入检测: " .. child.Name)
        end
    end)
end

