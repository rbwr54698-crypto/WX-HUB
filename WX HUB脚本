-- 提交
local function submit()
    local text = box.Text
    if text == nil or text == "" then
        status.Text = "⚠ 请先输入卡密"
        status.TextColor3 = Color3.fromRGB(255, 130, 130)

        -- 抖动反馈
        local origPos = box.Position
        for i = 1, 4 do
            TweenService:Create(box, TweenInfo.new(0.04), {
                Position = origPos + UDim2.fromOffset((i % 2 == 0) and 7 or -7, 0)
            }):Play()
            task.wait(0.04)
        end
        TweenService:Create(box, TweenInfo.new(0.06), {
            Position = origPos
        }):Play()
        return
    end

    -- 写入卡密并加载
    getgenv().SCRIPT_KEY = text

    status.Text = "🔓 正在加载脚本，请稍候..."
    status.TextColor3 = Color3.fromRGB(205, 170, 255)
    box.TextEditable = false
    execBtn.Text = "加载中..."

    task.wait(0.35)
    destroyUI()
    runScript()
end

execBtn.MouseButton1Click:Connect(submit)

box.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        submit()
    end
end)
