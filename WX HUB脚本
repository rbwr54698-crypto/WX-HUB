--=====================================================--


--=====================================================================
--  加载目标脚本
--=====================================================================
local function runScript()
    local ok, err = pcall(function()
        local src = game:HttpGet(SCRIPT_URL)
        local fn, compileErr = loadstring(src)
        if not fn then
            error("编译失败: " .. tostring(compileErr))
        end
        fn()
    end)
    if not ok then
        warn("[KeyAuth] 脚本加载失败: " .. tostring(err))
    end
    return ok, err
end


--=====================================================================
--  前置检测
--=====================================================================
local existingKey = getgenv().SCRIPT_KEY

-- 情况 1：用户压根没写 getgenv().SCRIPT_KEY（值为 nil） -> 踢出
if existingKey == nil then
    pcall(function()
        LocalPlayer:Kick(
            "【执行格式错误】\n\n" ..
            "你没有使用正确的执行格式。\n\n" ..
            "请按以下格式执行脚本：\n\n" ..
            "getgenv().SCRIPT_KEY = \"你的卡密\"\n" ..
            "loadstring(game:HttpGet(\"" .. SCRIPT_URL .. "\"))()"
        )
    end)
    return
end

-- 情况 2：写了并且有内容 -> 直接放行
if existingKey ~= "" then
    runScript()
    return
end

