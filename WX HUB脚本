    closeBtn.Size = UDim2.fromOffset(38, 38)
    closeBtn.Position = UDim2.fromOffset(CARD_W - 36 - 38, 246)
    closeBtn.BackgroundColor3 = Color3.fromRGB(34, 26, 52)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(196, 181, 253)
