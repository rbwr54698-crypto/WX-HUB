--================= 加载目标脚本 =================--
local function runScript()
    local ok, err = pcall(function()
        local src = g_httpget(SCRIPT_URL)
        if type(src) ~= "string" or src == "" then error("HttpGet 返回异常") end
        if type(g_loadstr) ~= "function" then error("执行器不支持 loadstring") end
        local fn, cerr = g_loadstr(src)
        if not fn then error("编译失败: " .. tostring(cerr)) end
        fn()
    end)
    if not ok then warn("[KeyAuth] 加载失败: " .. tostring(err)) end
    return ok
end

