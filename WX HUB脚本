local function runScript()
    local ok, err = pcall(function()
        local src = g_httpget(SCRIPT_URL)
        if type(src) ~= "string" or src == "" then
            error("HttpGet 返回为空，请检查网络或链接是否有效")
        end

        -- 优先使用捕获的 loadstring，如果为 nil 则直接调用全局 loadstring
        local loader = g_loadstr
        if type(loader) ~= "function" then
            loader = loadstring
        end
        if type(loader) ~= "function" then
            error("无法获取 loadstring，请重启执行器后重试")
        end

        local fn, cerr = loader(src)
        if not fn then
            error("编译失败: " .. tostring(cerr))
        end
        fn()
    end)
    if not ok then
        warn("[KeyAuth] 加载失败: " .. tostring(err))
    end
    return ok
end

