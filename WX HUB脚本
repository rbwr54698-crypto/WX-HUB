    -- 左下：购买卡密 y=246  h=38
    local buyBtn = Instance.new("TextButton")
    buyBtn.Size = UDim2.fromOffset(170, 38)
    buyBtn.Position = UDim2.fromOffset(36, 246)
    buyBtn.BackgroundColor3 = Color3.fromRGB(24, 19, 40)
    buyBtn.Text = "🛒 购买卡密"
    buyBtn.TextColor3 = Color3.fromRGB(196, 181, 253)
    buyBtn.Font = Enum.Font.GothamSemibold
    buyBtn.TextSize = 13
    buyBtn.BorderSizePixel = 0
    buyBtn.AutoButtonColor = false
    round(buyBtn, 10)
    buyBtn.Parent = card

    local buyStroke = Instance.new("UIStroke")
    buyStroke.Color = Color3.fromRGB(139, 92, 246)
    buyStroke.Thickness = 1
    buyStroke.Transparency = 0.4
    buyStroke.Parent = buyBtn

    buyBtn.MouseEnter:Connect(function()
        tween(buyStroke, 0.15, { Transparency = 0 })
        buyBtn.TextColor3 = Color3.fromRGB(233, 213, 255)
    end)
    buyBtn.MouseLeave:Connect(function()
        tween(buyStroke, 0.15, { Transparency = 0.4 })
        buyBtn.TextColor3 = Color3.fromRGB(196, 181, 253)
    end)

    buyBtn.MouseButton1Click:Connect(function()
        local ok = pcall(function() setclipboard(BUY_URL) end)
        local old = buyBtn.Text
        buyBtn.Text = ok and "✅ 链接已复制" or "❌ 复制失败"
