        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(24, 14, 44)),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(10, 7, 20)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(4, 3, 9)),
    })
    bgGrad.Rotation = 90
    bgGrad.Parent = bg

    -- ---------- 大颗粒紫色粒子 ----------
    local RNG = Random.new()
    local PARTICLE_COLORS = {
        Color3.fromRGB(139, 92, 246),
        Color3.fromRGB(168, 85, 247),
        Color3.fromRGB(192, 132, 252),
        Color3.fromRGB(216, 180, 254),
        Color3.fromRGB(124, 58, 237),
