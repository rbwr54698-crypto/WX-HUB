    title.Position = UDim2.fromOffset(0, 24)
    title.BackgroundTransparency = 1
    title.Text = "WX HUB"
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 30
    title.Parent = card

    local tGrad = Instance.new("UIGradient")
    tGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(216, 180, 254)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(168, 85, 247)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(124, 58, 237)),
    })
    tGrad.Parent = title

    task.spawn(function()
        local t = 0
        while title and title.Parent do
            t = (t + 0.008) % 1
