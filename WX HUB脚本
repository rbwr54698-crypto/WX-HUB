local RNG = Random.new()
local PARTICLE_COLORS = {
    Color3.fromRGB(139, 92, 246),
    Color3.fromRGB(168, 85, 247),
    Color3.fromRGB(192, 132, 252),
    Color3.fromRGB(216, 180, 254),
    Color3.fromRGB(124, 58, 237),
}

task.spawn(function()
    while gui and gui.Parent do
        local p = Instance.new("Frame")
        local size = RNG:NextInteger(7, 18)
        p.Size = UDim2.fromOffset(size, size)
        p.Position = UDim2.new(RNG:NextNumber(), 0, 1 + RNG:NextNumber() * 0.2, 0)
        p.BackgroundColor3 = PARTICLE_COLORS[RNG:NextInteger(1, #PARTICLE_COLORS)]
        p.BackgroundTransparency = RNG:NextNumber(0.1, 0.45)
        p.BorderSizePixel = 0
        p.Active = false
        round(p, size)
        p.Parent = bg

        local life  = RNG:NextNumber(4, 9)
        local drift = RNG:NextInteger(-140, 140)
        local grow  = RNG:NextNumber(1.1, 1.9)

        local tw = tween(p, life, {
            Position = UDim2.new(p.Position.X.Scale, drift, -0.15, 0),
            Size = UDim2.fromOffset(size * grow, size * grow),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Linear)
        tw.Completed:Connect(function() p:Destroy() end)

        task.delay(life * RNG:NextNumber(0.3, 0.6), function()
            if p and p.Parent then
                tween(p, 0.4, { BackgroundTransparency = 0.85 })
            end
        end)

        task.wait(RNG:NextNumber(0.12, 0.3))
    end
end)

