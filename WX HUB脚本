-- ============================================================
--  执行逻辑
-- ============================================================
local isExecuting = false

local function shakeInput()
    local basePos = inputWrap.Position
    tween(inputWrap, 0.06, { Position = basePos + UDim2.fromOffset(-8, 0) })
    task.wait(0.06)
    tween(inputWrap, 0.06, { Position = basePos + UDim2.fromOffset(8, 0) })
    task.wait(0.06)
    tween(inputWrap, 0.06, { Position = basePos })
end

local function doExecute()
    if isExecuting then return end

    local key = input.Text:gsub("%s", "")

    if #key == 0 then
        tip.Text = "⚠ 卡密为空，请先粘贴卡密！"
        shakeInput()
        return
    elseif #key <= 3 then
        tip.Text = "⚠ 卡密太短，请检查是否复制完整！"
        shakeInput()
        return
    end

    isExecuting = true
    tip.Text = ""
    getgenv().SCRIPT_KEY = key

    tween(card, 0.3, { BackgroundTransparency = 1 })
    tween(cardGlow, 0.3, { BackgroundTransparency = 1 })
    tween(bg, 0.3, { BackgroundTransparency = 1 })

    task.delay(0.32, function()
        gui:Destroy()
        loadMain()
    end)
end

runBtn.MouseButton1Click:Connect(doExecute)
input.FocusLost:Connect(function(enter)
    if enter then doExecute() end
end)
