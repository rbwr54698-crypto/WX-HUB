--[[
    ╔══════════════════════════════════════════════╗
    ║         卡密验证包装脚本（无UI精简版）          ║
    ╚══════════════════════════════════════════════╝

    上传托管站拿到链接后，要求买家按此格式执行：

        getgenv().SCRIPT_KEY = "填卡密"
        loadstring(game:HttpGet("上传后生成的链接"))()

    判定逻辑：
      · 填了卡密（非空，不管格式对不对） ——> 正常执行目标脚本
      · 没放 SCRIPT_KEY 这行，或放了但空的 ——> 复制购买链接 + 踢出服务器
]]

--═══════════════════ 配置区（按需修改）═══════════════════
local TARGET_URL = "https://api.jnkie.com/api/v1/luascripts/public/17c623de8d29bf1f8de353253ab468722d61b3ffce34150ca6302f08d96d65d2/download"
local BUY_URL    = "https://ds.xiaoman.top/links/342F4A3D"
--══════════════════════════════════════════════════════════

local providedKey = getgenv().SCRIPT_KEY

-- 没放 getgenv().SCRIPT_KEY = "" 这行（nil），或放了但引号是空的 —— 一律踢出
if providedKey == nil or providedKey == "" then
    -- 踢出前先把购买链接复制到剪贴板
    pcall(setclipboard, BUY_URL)
    game:GetService("Players").LocalPlayer:Kick(
        "请先购买卡密去执行脚本。\n\n卡密网站已复制，加客服QQ1969727442"
    )
    return
end

-- 填了卡密（非空即可，不校验格式）—— 喂给目标脚本并执行
getgenv().SCRIPT_KEY = providedKey
loadstring(game:HttpGet(TARGET_URL))()
