    input.Font = Enum.Font.GothamMedium
    input.TextSize = 14
    input.ClearTextOnFocus = false
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.ClipsDescendants = true
    input.Parent = inputWrap

    input.Focused:Connect(function()
        tween(inputStroke, 0.2, { Color = Color3.fromRGB(168, 85, 247), Thickness = 2 })
    end)
    input.FocusLost:Connect(function()
        tween(inputStroke, 0.2, { Color = Color3.fromRGB(109, 74, 199), Thickness = 1.5 })
    end)

    -- 错误提示 y=152  h=16
    local tip = Instance.new("TextLabel")
    tip.Size = UDim2.fromOffset(CARD_W, 16)
    tip.Position = UDim2.fromOffset(0, 152)
    tip.BackgroundTransparency = 1
    tip.Text = ""
    tip.TextColor3 = Color3.fromRGB(255, 110, 160)
